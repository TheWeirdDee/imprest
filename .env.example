# ---------------------------------------------------------------------------
# Imprest environment. Copy to .env and fill locally. NEVER commit .env.
# ---------------------------------------------------------------------------

# Which network block of config/networks.json the services and web app use:
# development | testnet | mainnet
IMPREST_ENV=testnet

# Optional RPC overrides (otherwise config/networks.json rpcUrls[0] / [1] are used).
# The verification RPC MUST be a different provider from the primary RPC.
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_TESTNET_VERIFY_RPC_URL=https://rpc-testnet.monadinfra.com
MONAD_MAINNET_RPC_URL=https://rpc.monad.xyz
MONAD_MAINNET_VERIFY_RPC_URL=https://rpc-mainnet.monadinfra.com

# Deployment (owner-only). Use a fresh testnet-only key. Never a mainnet key here.
DEPLOYER_PRIVATE_KEY=
IMPREST_OPERATOR=
IMPREST_TREASURY=

# Source verification on Monadscan (Etherscan v2 API)
MONAD_EXPLORER_API_KEY=
MONAD_TESTNET_VERIFIER_URL=https://api.etherscan.io/v2/api?chainid=10143

# Relayer: pays gas for trader-signed intents; can only submit what was signed.
RELAYER_PRIVATE_KEY=
RELAYER_PORT=8787
RELAYER_MAX_GAS=1200000
RELAYER_QUOTA_PER_TRADER_PER_MIN=20

# Keeper: watches desks, calls enforce/graduate/checkpoint. Never authoritative.
KEEPER_PRIVATE_KEY=
KEEPER_POLL_MS=2000

# Indexer (Envio HyperIndex)
ENVIO_API_TOKEN=

# Web
NEXT_PUBLIC_IMPREST_ENV=testnet
NEXT_PUBLIC_RELAYER_URL=http://localhost:8787
NEXT_PUBLIC_INDEXER_URL=http://localhost:8080/v1/graphql
NEXT_PUBLIC_PASSKEY_RP_ID=localhost
# Development-only mock account. Ignored unless IMPREST_ENV=development.
NEXT_PUBLIC_ENABLE_DEV_MOCK_ACCOUNT=false
