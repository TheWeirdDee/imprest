[
 {
  "text": "Hi, I'm Divine and I",
  "start": 0.0,
  "end": 1.92
 },
 {
  "text": "built Imprest.",
  "start": 1.92,
  "end": 3.41
 },
 {
  "text": "So a trader may have",
  "start": 3.94,
  "end": 5.36
 },
 {
  "text": "the skills to manage a",
  "start": 5.36,
  "end": 6.88
 },
 {
  "text": "larger trading account but",
  "start": 6.88,
  "end": 8.775
 },
 {
  "text": "not the money to fund",
  "start": 8.775,
  "end": 10.4
 },
 {
  "text": "one.",
  "start": 10.4,
  "end": 11.14
 },
 {
  "text": "The person providing that",
  "start": 11.14,
  "end": 12.26
 },
 {
  "text": "money has a different concern.",
  "start": 12.26,
  "end": 14.75
 },
 {
  "text": "How do they give the",
  "start": 15.06,
  "end": 15.66
 },
 {
  "text": "trader room to trade while",
  "start": 15.66,
  "end": 16.96
 },
 {
  "text": "keeping clear limits on how",
  "start": 16.96,
  "end": 18.78
 },
 {
  "text": "that capital is used?",
  "start": 18.78,
  "end": 20.29
 },
 {
  "text": "Imprest brings those two",
  "start": 20.44,
  "end": 21.42
 },
 {
  "text": "sides together.",
  "start": 21.42,
  "end": 22.38
 },
 {
  "text": "A trader starts with their",
  "start": 22.38,
  "end": 23.37
 },
 {
  "text": "own stake and completes an",
  "start": 23.37,
  "end": 24.92
 },
 {
  "text": "evaluation.",
  "start": 24.92,
  "end": 25.79
 },
 {
  "text": "If they meet the requirements",
  "start": 25.96,
  "end": 26.94
 },
 {
  "text": "they can qualify for a",
  "start": 26.94,
  "end": 28.1
 },
 {
  "text": "larger account supported",
  "start": 28.1,
  "end": 29.48
 },
 {
  "text": "by a lending pool.",
  "start": 29.48,
  "end": 30.95
 },
 {
  "text": "That additional capital stays",
  "start": 31.22,
  "end": 33.08
 },
 {
  "text": "in the trading account.",
  "start": 33.08,
  "end": 34.63
 },
 {
  "text": "It isn't money the trader",
  "start": 35.1,
  "end": 36.7
 },
 {
  "text": "can simply withdraw.",
  "start": 36.7,
  "end": 38.27
 },
 {
  "text": "What makes Imprest different",
  "start": 38.6,
  "end": 40.02
 },
 {
  "text": "is how the rules work.",
  "start": 40.02,
  "end": 42.03
 },
 {
  "text": "The trading account has a",
  "start": 42.22,
  "end": 43.8
 },
 {
  "text": "smart contract that checks",
  "start": 43.8,
  "end": 45.76
 },
 {
  "text": "supported orders against",
  "start": 45.76,
  "end": 47.86
 },
 {
  "text": "its limits.",
  "start": 47.86,
  "end": 48.97
 },
 {
  "text": "Traders can see their progress,",
  "start": 49.4,
  "end": 50.99
 },
 {
  "text": "their risk and what they",
  "start": 51.3,
  "end": 53.033
 },
 {
  "text": "need to do before profit",
  "start": 53.033,
  "end": 54.12
 },
 {
  "text": "becomes eligible for withdrawal.",
  "start": 54.12,
  "end": 55.91
 },
 {
  "text": "I am building this because",
  "start": 56.15,
  "end": 57.3
 },
 {
  "text": "access to capital should",
  "start": 57.3,
  "end": 58.26
 },
 {
  "text": "come with rules people can",
  "start": 58.26,
  "end": 59.74
 },
 {
  "text": "inspect and also understand.",
  "start": 59.74,
  "end": 62.01
 },
 {
  "text": "Traders need clarity about",
  "start": 62.4,
  "end": 63.78
 },
 {
  "text": "their obligations and the",
  "start": 63.78,
  "end": 65.8
 },
 {
  "text": "capital providers need visibility",
  "start": 65.8,
  "end": 68.24
 },
 {
  "text": "into how their money is",
  "start": 68.24,
  "end": 70.08
 },
 {
  "text": "being used as well.",
  "start": 70.08,
  "end": 71.61
 },
 {
  "text": "The prototype runs on Monad",
  "start": 71.9,
  "end": 73.56
 },
 {
  "text": "Testnet and connects to Perpl's",
  "start": 73.56,
  "end": 75.785
 },
 {
  "text": "testnet exchange.",
  "start": 75.785,
  "end": 77.25
 },
 {
  "text": "We demonstrated opening an",
  "start": 77.52,
  "end": 79.0
 },
 {
  "text": "account, placing and closing",
  "start": 79.0,
  "end": 80.84
 },
 {
  "text": "trades and returning remaining",
  "start": 80.84,
  "end": 82.68
 },
 {
  "text": "capital when an account closes.",
  "start": 82.68,
  "end": 85.35
 },
 {
  "text": "Successful browser profit",
  "start": 85.56,
  "end": 87.08
 },
 {
  "text": "payouts are still an open",
  "start": 87.08,
  "end": 88.82
 },
 {
  "text": "verification step.",
  "start": 88.82,
  "end": 90.43
 },
 {
  "text": "Our next goal is a",
  "start": 90.82,
  "end": 91.96
 },
 {
  "text": "small pilot with experienced",
  "start": 91.96,
  "end": 94.24
 },
 {
  "text": "traders and prospective capital",
  "start": 94.24,
  "end": 96.46
 },
 {
  "text": "providers using their feedback",
  "start": 96.46,
  "end": 98.32
 },
 {
  "text": "to improve the product before",
  "start": 98.32,
  "end": 99.72
 },
 {
  "text": "considering real funds.",
  "start": 99.72,
  "end": 102.01
 },
 {
  "text": "Imprest's aim is simple.",
  "start": 102.82,
  "end": 104.57
 },
 {
  "text": "Make access to trading capital",
  "start": 105.04,
  "end": 106.28
 },
 {
  "text": "more transparent with clear",
  "start": 106.28,
  "end": 108.74
 },
 {
  "text": "rules for both sides.",
  "start": 108.74,
  "end": 111.73
 },
 {
  "text": "Thank you.",
  "start": 114.28,
  "end": 117.37
 }
]